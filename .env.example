# Copy to .env and adjust. Use ABSOLUTE paths when a client launches the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./token.json
# Hosted deployments only: the full contents of token.json as one line (instead of a file).
GOOGLE_TOKEN_JSON=
# Alternative to CLIENT_ID/SECRET: a downloaded "Desktop app" credentials.json
# GOOGLE_CREDENTIALS_PATH=./credentials.json

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# (Hosting platforms that inject PORT are supported; MCP_PORT wins if both are set.)
# REQUIRED when MCP_TRANSPORT=http. Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Comma-separated Host header values to accept in http mode when served behind a tunnel/proxy,
# e.g. my-tunnel.example.com. Empty = localhost only.
MCP_ALLOWED_HOSTS=

# Limits
MAX_RECIPIENTS=50
MAX_EMAIL_BODY_BYTES=1048576
MAX_DOC_APPEND_BYTES=102400
REQUEST_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
